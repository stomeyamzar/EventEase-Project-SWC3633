    {
      "name": "Admin metrics with API key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin metrics returns 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Metrics response contains counts\", () => { const d = pm.response.json().data; pm.expect(d).to.have.property(\"users\"); pm.expect(d).to.have.property(\"events\"); pm.expect(d).to.have.property(\"bookings\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/metrics",
